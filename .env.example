# Copie para .env (que é gitignored) e preencha.
# Variáveis de ambiente têm precedência sobre este arquivo.

# Chave da API DeepSeek, usada pela barra de correção de frases.
# Sem ela o app sobe normalmente e a barra avisa que falta configurar.
DEEPSEEK_API_KEY=

# Verificação de certificado TLS. Deixe "true" (padrão) sempre que possível.
# Use "false" em redes que interceptam TLS com uma raiz self-signed — sem isso
# o requests falha com CERTIFICATE_VERIFY_FAILED. Alternativa mais segura:
# aponte esta variável para o caminho do CA bundle corporativo.
SSL_VERIFY=true
